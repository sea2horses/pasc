// Expresiones en lenguaje coloquial
Algoritmo Coloquial
	Definir n, divisor Como Entero
	Escribir "Ingrese un numero:"
	Leer n
	divisor <- 3

	Si n es par Entonces
		Escribir n, " es par"
	SiNo
		Escribir n, " es impar"
	FinSi

	Si n es positivo Entonces
		Escribir n, " es positivo"
	FinSi

	Si n es mayor o igual que 10 Y n es menor que 100 Entonces
		Escribir n, " tiene dos cifras"
	FinSi

	Si n es divisible por divisor Entonces
		Escribir n, " es multiplo de ", divisor
	FinSi

	Si NO n es cero Entonces
		Escribir n, " no es cero"
	FinSi
FinAlgoritmo
